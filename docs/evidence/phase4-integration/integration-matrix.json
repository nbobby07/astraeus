  "scenarios": [
    {
      "id": "A",
      "name": "Base install and boot",
      "expected_behavior": "Fresh integrated ISO installs plain/LUKS2 Btrfs, then two UEFI disk-only boots and installed-smoke.sh pass",
      "status": "PASS",
      "actual": "Fresh plain and LUKS2 installations, two cold enforcing UEFI boots each, actual Plasma Wayland, Btrfs, network/audio and health checks."
    },
    {
      "id": "B",
      "name": "Gaming packages",
      "expected_behavior": "Signed package resolution succeeds, pacman -Dk is coherent; package presence alone establishes no runtime result",
      "status": "PASS",
      "actual": "Signed pinned image inputs and coherent native/lib32 package database; Core and tools explicitly selected."
    },
    {
      "id": "C",
      "name": "Native Vulkan loader and ICD",
      "expected_behavior": "Valid ICD manifests, architecture-compatible loader libraries and real vulkaninfo enumeration with exact device/driver observations",
      "status": "PASS",
      "actual": "Real native loader/ICDs, Vulkan enumeration and software device identity; no physical device qualified."
    },
    {
      "id": "D",
      "name": "Vulkan execution",
      "expected_behavior": "64-bit queue submission clears an image, fence completes and 256 pixels match; record renderer/ICD, software status and separately qualify WSI",
      "status": "PASS",
      "actual": "ELF64 Vulkan clears/readbacks all 256 pixels; native WSI moving cube separately observed. Software only."
    },
    {
      "id": "E",
      "name": "32-bit Vulkan",
      "expected_behavior": "lib32 dependency checks plus ELF32 loader/ICD execution and verified readback; missing runtime remains UNVERIFIED even if packages pass",
      "status": "PASS",
      "actual": "ELF32 loader/ICD and 256-pixel readback pass. ELF32 OpenGL presentation also passes; 32-bit Vulkan WSI remains NOT RUN."
    },
    {
      "id": "F",
      "name": "Steam runtime and session",
      "expected_behavior": "Dependencies and runtime diagnosed, unprivileged Wayland/XWayland launch inspected, process lifetime/exit/logs captured; stop at login boundary",
      "status": "PASS",
      "actual": "Steam client reached usable empty login window, runtime/dependencies diagnosed, normal close exit 0. No authentication or game acceptance."
    },
    {
      "id": "G",
      "name": "Proton Win32 smoke",
      "expected_behavior": "Explicit Steam Linux Runtime starts inspected Proton; checksum-pinned own Win32 fixture creates a window and returns a fresh nonce with exit zero",
      "status": "FAIL",
      "actual": "Normal Proton run exits 0 without nonce. Genuine runinprefix diagnostic in initialized disposable prefix executes Win32 window fixture and fresh nonce, exit 0; this bounded subcheck does not replace the failed normal path."
    },
    {
      "id": "H",
      "name": "Gamescope nested launch",
      "expected_behavior": "Nested gamescope starts bounded vkcube presentation or documents unsupported virtual-device prerequisites and exact launch diagnostics",
      "status": "UNSUPPORTED",
      "actual": "Nested Gamescope aborts 134 on llvmpipe with missing DRM/VK_EXT_physical_device_drm prerequisites; no presentation pass."
    },
    {
      "id": "I",
      "name": "MangoHud and GameMode",
      "expected_behavior": "Wrapper workloads run, visible overlay is independently inspected, daemon readiness/test/invocation and restoration pass; no FPS benefit claim",
      "status": "FAIL",
      "actual": "Visible native Vulkan/OpenGL and ELF32 OpenGL MangoHud, plus ELF32 Vulkan layer invocation pass. GameMode wrapper/restoration passes; full self-test fails 255 without CPU governor interface. OpenGL window closes return 143, not zero."
    },
    {
      "id": "J",
      "name": "Gaming readiness CLI JSON",
      "expected_behavior": "Real production interface returns parseable JSON matching actual driver/runtime limitations, without claiming physical GPU qualification",
      "status": "PASS",
      "actual": "Actual status/doctor JSON validates and reports software readback separately from unsupported hardware acceleration. Raw PCI binding and driver-selection issues remain visible."
    },
    {
      "id": "K",
      "name": "Controlled negatives",
      "expected_behavior": "Missing/corrupt ICD, wrong ELF architecture, missing lib32 ICD, no device, unknown vendor, absent Steam/Proton, unsupported gamescope, dependency mismatch, transaction refusal and invalid preset yield actionable diagnostics without crashes or false readiness",
      "status": "FAIL",
      "actual": "Four ICD/architecture and nine production negatives pass; vendor policies covered by controlled Rust fixtures. Gamescope unsupported-device launch still aborts, so the complete no-crash negative requirement is unmet."
    },
    {
      "id": "L",
      "name": "Encrypted gaming setup",
      "expected_behavior": "Signed feature setup through authorized product transaction in disposable LUKS2 installation, user-session smoke and disk-only reboot preserve encryption",
      "status": "UNSUPPORTED",
      "actual": "Initial signed gaming image passes encrypted boots and probes. Targeted feature transactions remain blocked proposals, not executable setup."
    },
    {
      "id": "M",
      "name": "Signed update and rollback",
      "expected_behavior": "Existing Phase 3 H/I/J/K/M plus Phase 2 payload/space/package/health/service/interruption regressions pass after gaming integration; known-good pairs, histories, snapshots, recovery and direct-package guard preserved",
      "status": "PASS",
      "actual": "All source-bound Phase 3 update/fallback/recovery/powercut/metadata gates and Phase 2 payload/space/package/health/service/interruption/direct-package regressions pass."
    },
    {
      "id": "N",
      "name": "Enforcing Secure Boot",
      "expected_behavior": "Existing trusted boot and unsigned/untrusted/tampered loader/UKI tests refuse exact integrated bytes with authentication evidence; native UKI signing retained",
      "status": "PASS",
      "actual": "Enforced real boot plus exact integrated loader/UKI trusted controls and unsigned/untrusted/tampered firmware refusals with denied-image records."
    },
    {
      "id": "O",
      "name": "Independent ISO bytes",
      "expected_behavior": "Only after production merges, two clean signed builds have identical complete ISO bytes, package manifests and hashes",
      "status": "PASS",
      "actual": "Independent clean builds, full-file comparison exit 0 and identical package manifests/ISO SHA256."
    },
    {
      "id": "P",
