[
  "qemu-system-x86_64",
  "-machine",
  "q35,accel=kvm,smm=on",
  "-cpu",
  "host",
  "-m",
  "4096",
  "-smp",
  "4",
  "-device",
  "virtio-vga",
  "-drive",
  "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd",
  "-drive",
  "if=pflash,format=raw,file=/home/ubuntu/p3i/final/reg-service/vars.fd",
  "-drive",
  "if=none,id=osdisk,format=qcow2,file=/home/ubuntu/p3i/final/reg-service/disk.qcow2",
  "-device",
  "virtio-blk-pci,drive=osdisk,bootindex=1",
  "-nic",
  "user,model=virtio-net-pci",
  "-display",
  "none",
  "-serial",
  "file:/home/ubuntu/p3i/final/reg-service/boot-3/serial.log",
  "-monitor",
  "none",
  "-qmp",
  "unix:/home/ubuntu/p3i/final/reg-service/boot-3/qmp.sock,server=on,wait=off",
  "-device",
  "qemu-xhci",
  "-device",
  "usb-tablet",
  "-global",
  "driver=cfi.pflash01,property=secure,value=on",
  "-virtfs",
  "local,path=/home/ubuntu/p3i/final/reg-service/share,mount_tag=acceptance,security_model=none,readonly=on",
  "-no-reboot",
  "-device",
  "virtio-serial-pci",
  "-chardev",
  "socket,id=validation,path=/home/ubuntu/p3i/final/reg-service/boot-3/guest.sock,server=on,wait=off",
  "-device",
  "virtserialport,chardev=validation,name=org.astraeus.validation"
]
