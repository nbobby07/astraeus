pkgname=distroctl
pkgver=@@VERSION@@
pkgrel=1
pkgdesc='Distribution status, transactions, snapshots and recovery tools'
arch=('x86_64')
depends=('gcc-libs' 'glibc' 'lib32-glibc' 'btrfs-progs' 'util-linux' 'coreutils' 'systemd' 'cryptsetup' 'pacman' 'libarchive' 'mkinitcpio' 'systemd-ukify' 'python' 'openssl' 'sbsigntools' 'efitools')
makedepends=('rust' 'gcc' 'lib32-glibc' 'lib32-gcc-libs' 'vulkan-headers')
source=('platform.tar.xz')
sha256sums=('@@SHA256@@')
options=('!lto')

prepare() {
  [[ $(/usr/bin/rustc --version | cut -d ' ' -f 2) == '@@RUST_VERSION@@' ]] || {
    echo 'Use the pinned Arch builder Rust package; see docs/building.md.' >&2
    return 1
  }
}

build() {
  cd "$srcdir/platform"
  export RUSTC=/usr/bin/rustc
  export CARGO_HOME="$srcdir/cargo-home"
  /usr/bin/cargo build --frozen --release -p distroctl
  /usr/bin/cc -std=c11 -O2 -Wall -Wextra -Werror scripts/graphics-probe.c -ldl -o target/graphics-probe64
  /usr/bin/cc -m32 -std=c11 -O2 -Wall -Wextra -Werror scripts/graphics-probe.c -ldl -o target/graphics-probe32
}

check() {
  cd "$srcdir/platform"
  export RUSTC=/usr/bin/rustc
  export CARGO_HOME="$srcdir/cargo-home"
  /usr/bin/cargo test --frozen --workspace
}

package() {
  cd "$srcdir/platform"
  install -Dm755 target/release/distroctl "$pkgdir/usr/bin/distroctl"
  install -Dm755 target/graphics-probe64 "$pkgdir/usr/lib/distroctl/graphics-probe64"
  install -Dm755 target/graphics-probe32 "$pkgdir/usr/lib/distroctl/graphics-probe32"
  install -Dm644 docs/graphics.md "$pkgdir/usr/share/doc/distroctl/graphics.md"
  install -Dm644 distro/branding/project.toml "$pkgdir/usr/share/distro/project.toml"
  install -Dm644 distro/installed/astraeus-confirm-boot.service "$pkgdir/usr/lib/systemd/system/astraeus-confirm-boot.service"
  install -Dm644 distro/installed/astraeus-bless-boot.conf "$pkgdir/usr/lib/systemd/system/systemd-bless-boot.service.d/astraeus.conf"
  install -Dm644 docs/snapshots.md "$pkgdir/usr/share/doc/distroctl/offline-recovery.md"
  install -Dm755 scripts/secure_boot.py "$pkgdir/usr/bin/astraeus-secure-boot"
  install -Dm755 scripts/secure_boot.py "$pkgdir/usr/bin/astraeus-boot-artifact"
  install -Dm644 distro/installed/80-astraeus-secure-boot.hook "$pkgdir/usr/share/libalpm/hooks/80-astraeus-secure-boot.hook"
  install -Dm644 docs/secure-boot.md "$pkgdir/usr/share/doc/distroctl/secure-boot.md"
  install -Dm644 docs/adr/0003-owner-secure-boot.md "$pkgdir/usr/share/doc/distroctl/adr/0003-owner-secure-boot.md"
  install -Dm644 distro/installed/secure-boot/linux.preset "$pkgdir/usr/share/distro/secure-boot/linux.preset"
  install -Dm755 distro/installed/secure-boot/95-astraeus-sign "$pkgdir/usr/lib/initcpio/post/95-astraeus-sign"
  install -Dm644 docs/boot-generations.md "$pkgdir/usr/share/doc/distroctl/boot-generations.md"
}
