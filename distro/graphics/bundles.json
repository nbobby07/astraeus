{
  "schema_version": 1,
  "base": ["mesa", "lib32-mesa", "vulkan-icd-loader", "lib32-vulkan-icd-loader", "vulkan-tools"],
  "bundles": {
    "amd": ["linux-firmware-amdgpu", "vulkan-radeon", "lib32-vulkan-radeon"],
    "intel": ["linux-firmware-intel", "vulkan-intel", "lib32-vulkan-intel"],
    "nouveau": ["linux-firmware-nvidia", "vulkan-nouveau", "lib32-vulkan-nouveau"],
    "virtio": ["vulkan-virtio", "lib32-vulkan-virtio"],
    "software": ["vulkan-swrast", "lib32-vulkan-swrast", "mesa-utils", "lib32-mesa-utils"],
    "nvidia-open": ["nvidia-open", "nvidia-utils", "lib32-nvidia-utils", "egl-wayland", "egl-wayland2", "egl-gbm"]
  },
  "build": ["gcc", "lib32-glibc", "lib32-gcc-libs", "vulkan-headers"],
  "optional": ["mesa-utils", "lib32-mesa-utils", "nvidia-prime"]
