{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astraeus gaming plan v1",
  "type": "object",
  "required": [
    "schema_version",
    "feature",
    "operation",
    "archive_date",
    "executable",
    "dependency_resolution",
    "requests",
    "graphics_requirements",
    "flatpak_requests",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "feature": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "enable",
        "disable"
      ]
    },
    "archive_date": {
      "type": "string",
      "pattern": "^[0-9]{4}/[0-9]{2}/[0-9]{2}$"
    },
    "executable": {
      "const": false
    },
    "dependency_resolution": {
      "type": "string"
    },
    "requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/request"
      }
    },
    "graphics_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flatpak_requests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "package": {
      "type": "object",
      "required": [
        "repository",
        "version",
        "sha256",
        "depends",
        "provides"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "depends": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "request": {
      "type": "object",
      "required": [
        "name",
        "pinned",
        "installed_version",
        "action"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "pinned": {
          "$ref": "#/$defs/package"
        },
        "installed_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "enum": [
            "unknown",
            "install_requested",
            "keep_installed",
            "absent",
            "removal_review_required"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
